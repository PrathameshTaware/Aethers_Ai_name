# Copy to infra/.env (git-ignored) and fill in. Every entry is optional; scripts/deploy.py passes the ones that are
# set to CloudFormation as hidden (NoEcho) parameters. Never put real values in this file.

# Labelled fallback model, used only when Bedrock fails
FALLBACK_MODEL_API_KEY=

# Demo WhatsApp delivery through the Twilio sandbox
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# Comma-separated phones that have joined the sandbox
DEMO_WHATSAPP_TO=whatsapp:+91XXXXXXXXXX

# Front end: put this one in .env.local at the repo root instead (read only by the server-side admin proxy)
# SAANS_ADMIN_KEY=
